# Core Render Docker defaults are already pre-configured in Dockerfile:
# NODE_ENV=production, PORT=10000, HOST=0.0.0.0, DISABLE_HMR=true
# APP_NAME="Choy Chat", APP_VERSION="2.6.0", APP_URL="https://chat-9-si9x.onrender.com"
# PWA_THEME_COLOR="#022c22", CACHE_MODE="lightweight-auto", SUPABASE_BUCKET="choychat-media", PG_POOL_MAX=15

# Cloud Database (Render PostgreSQL External URL here / Internal URL on Render)
DATABASE_URL=
# Optional dedicated Pooler URI (if different from DATABASE_URL):
# DATABASE_POOL_URL=

# Optional Admin Override Credentials (If unset, first user claims Admin via setup form)
ADMIN_PHONE=
ADMIN_PIN=

# Optional Secret Keys
GEMINI_API_KEY=

# Optional Cloudflare R2 Video & Media Storage (10 GB Free, Zero Egress — keeps Supabase small)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=choychat
R2_PUBLIC_URL=

# Optional Supabase Cloud Media Storage & Private KYC Bucket
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_KYC_BUCKET=choychat-private-kyc

# Optional AES-256 Encryption Key for Admin-Only Real Names (falls back to SESSION_SECRET)
KYC_ENCRYPTION_KEY=

# Optional GitHub OAuth (Security Studio -> GitHub Intelligence)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Online Payment Terminal & Stripe Integration
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CONFIG_ID=
STRIPE_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=

# Optional Semaphore SMS OTP (Subscriptions, Payments & Withdrawals — Not required for Create Account)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=


